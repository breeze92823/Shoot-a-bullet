# Skips the Bloxity SDK (sdk.bloxity.io) and avatar CDN (static.bloxity.io) so local dev never depends on them.
# In dev mode the game talks to the local server (Shoot-a-bullet-backend, `npm start`) at ws://localhost:2567.
VITE_DEV_MODE=false

# Optional: another game server URL (ws://... or http://...). Leave unset in deployed builds: they reach
# the backend through the Bloxity matchmaker.
# VITE_SERVER_URL=

# Optional: the Bloxity game id when it differs from the default (CI sets it from LEGION_GAME_ID).
# VITE_GAME_SLUG=shoot-a-bullet
